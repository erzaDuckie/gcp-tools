{
  "manifest_version": 3,
  "name": "GCP TOOLS by ERZA",
  "version": "4.0.1",
  "description": "All-in-one GCP Tools: Bulk CPT, Bulk Package, Bulk Change Race, Give Item Helper",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "https://*.gamecp.net/*",
    "https://docs.google.com/*",
    "https://gcp-tools-license.levin-erza.workers.dev/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RZR GameCP Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["https://*.gamecp.net/*"]
    },
    {
      "resources": ["bg.webp"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.gamecp.net/*"],
      "js": ["content_autologin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.gamecp.net/*"],
      "js": ["content_bank.js", "content_give.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.gamecp.net/*"],
      "js": ["give_page_helper.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}