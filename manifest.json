{
  "manifest_version": 3,
  "name": "GCP TOOLS by ERZA",
  "version": "3.0",
  "description": "All-in-one GCP Tools: Bulk CPT, Bulk Insert High, Edit Inventory, Bulk Change Race",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "https://*.gamecp.net/*",
    "https://raw.githubusercontent.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RZR GameCP Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "https://*.gamecp.net/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.gamecp.net/index.php?do=admin_manage_edit_inventory*"
      ],
      "js": [
        "edit_inven_content.js"
      ],
      "css": [
        "edit_inven_content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
